rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read/write own document only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lost reports: citizens create their own; authenticated users can read
    match /lost_reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Found items: police stations create; authenticated users can read
    match /found_items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.policeStationId == request.auth.uid;
      allow update: if request.auth != null && resource.data.policeStationId == request.auth.uid;
    }

    // Matches: authenticated users can read
    // Write is done by server-side API routes using the same auth
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
